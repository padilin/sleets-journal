---
interface Link {
  href: string;
  title: string;
}

interface Props {
  previous?: Link;
  next?: Link;
}

const { previous, next } = Astro.props;
---

<nav class="journal-navigation" aria-label="Journal entries">
  <div class="previous">
    {previous && <a href={previous.href} data-page-turn="previous">← {previous.title}</a>}
  </div>
  <a class="journal-index-link" href="/journal/">Journal index</a>
  <div class="next">
    {next && <a href={next.href} data-page-turn="next">{next.title} →</a>}
  </div>
</nav>
