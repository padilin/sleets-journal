---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"journal">[];
}

const { entries } = Astro.props;
---

<section class="search" aria-labelledby="search-heading">
  <p class="eyebrow">Find a field note</p>
  <h1 id="search-heading">Search the journal</h1>
  <p class="search-intro">Search by title, place, person, or words from an entry.</p>
  <label class="search-label" for="journal-search">Search terms</label>
  <div class="search-field">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
    <input id="journal-search" type="search" placeholder="Try “forest” or “The World”" autocomplete="off" />
  </div>
  <p class="search-status" aria-live="polite">{entries.length} {entries.length === 1 ? "entry" : "entries"} in the journal</p>

  <ol class="search-results">
    {entries.map((entry) => (
      <li data-search={`${entry.data.title} ${entry.data.location} ${entry.data.date_display} ${entry.data.people.join(" ")} ${entry.data.tags.join(" ")} ${entry.body}`}>
        <span class="entry-number">{String(entry.data.entry).padStart(3, "0")}</span>
        <a class="entry-link" href={`/journal/${entry.id}/`}>
          <span class="entry-title">{entry.data.title}</span>
          <span class="entry-details">{entry.data.date_display} · {entry.data.location}</span>
        </a>
        <span class="entry-arrow" aria-hidden="true">→</span>
      </li>
    ))}
  </ol>
  <p class="search-empty" hidden>No entries match those words. Try a place, person, or a broader term.</p>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>("#journal-search");
  const results = [...document.querySelectorAll<HTMLElement>(".search-results li")];
  const status = document.querySelector<HTMLElement>(".search-status");
  const empty = document.querySelector<HTMLElement>(".search-empty");

  input?.addEventListener("input", () => {
    const terms = input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
    let visible = 0;

    for (const result of results) {
      const haystack = result.dataset.search?.toLocaleLowerCase() ?? "";
      const matches = terms.every((term) => haystack.includes(term));
      result.hidden = !matches;
      if (matches) visible += 1;
    }

    if (status) status.textContent = terms.length ? `${visible} ${visible === 1 ? "entry" : "entries"} found` : `${results.length} ${results.length === 1 ? "entry" : "entries"} in the journal`;
    if (empty) empty.hidden = visible !== 0;
  });
</script>
