---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"journal">[];
}

const { entries } = Astro.props;
---

<ol class="entry-list">
  {entries.map((entry) => (
    <li>
      <span class="entry-number">{String(entry.data.entry).padStart(3, "0")}</span>
      <a class="entry-link" href={`/journal/${entry.id}/`}>
        <span class="entry-title">{entry.data.title}</span>
        <span class="entry-details">
          <span>{entry.data.date_display}</span>
          <span aria-hidden="true">·</span>
          <span>{entry.data.location}</span>
        </span>
      </a>
      <span class="entry-arrow" aria-hidden="true">→</span>
    </li>
  ))}
</ol>
