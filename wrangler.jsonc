{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sleet-journal",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "sleet.adventure.pub",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
